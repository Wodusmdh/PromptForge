{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:compiler": "tsx src/compiler/tests/pipeline.test.ts",
    "test:orchestrator": "tsx src/compiler/tests/orchestrator.test.ts",
    "test:runtime": "tsx src/runtime/tests/runtime.test.ts",
    "test:sdk": "tsx src/sdk/tests/sdk.test.ts",
    "test:intelligence": "tsx src/intelligence/tests/intelligence.test.ts",
    "test:optimization": "tsx src/optimization/tests/optimization.test.ts",
    "test:api": "tsx src/api/tests/api.test.ts",
    "test:cli": "tsx src/cli/tests/cli.test.ts",
    "test:playground": "tsx src/playground/tests/playground.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
